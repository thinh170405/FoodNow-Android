<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"  android:background="@drawable/bg_card_touch" android:layout_marginBottom="12dp" android:padding="14dp">
  <ImageView android:layout_width="72dp" android:layout_height="72dp" android:src="@drawable/ic_circlek" android:contentDescription="@null" android:id="@+id/ivImage" android:scaleType="fitCenter" android:padding="6dp" android:background="@drawable/bg_soft" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_20" android:textSize="18sp" android:textColor="@color/ink" android:id="@+id/tvName" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_21" android:textSize="14sp" android:textColor="@color/ink" android:id="@+id/tvAddress" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="6dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_41" android:textSize="12sp" android:textColor="@color/ink" android:layout_marginTop="6dp" />
  </LinearLayout>
</LinearLayout>