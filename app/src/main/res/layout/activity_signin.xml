<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <ImageView android:layout_width="132dp" android:layout_height="108dp" android:src="@drawable/dish" android:contentDescription="@null" android:id="@+id/dishTop" android:layout_alignParentEnd="true" android:scaleType="fitEnd" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_below="@id/dishTop" android:layout_marginHorizontal="32dp" android:orientation="vertical">
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_1" android:textSize="36sp" android:textColor="@color/green" android:textStyle="bold" android:gravity="center" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_25" android:textSize="14sp" android:textColor="@color/ink" android:gravity="center" android:layout_marginBottom="24dp" />
      <EditText android:id="@+id/txtEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_4" android:inputType="textEmailAddress" android:textSize="16sp" android:drawableStart="@drawable/icon_email" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
      <EditText android:id="@+id/txtPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_26" android:inputType="textPassword" android:textSize="16sp" android:drawableStart="@drawable/icon_lock" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_27" android:textSize="14sp" android:textColor="@color/ink" android:id="@+id/btnForgot" android:gravity="end" android:minHeight="48dp" android:paddingTop="12dp" android:clickable="true" android:focusable="true" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
          <Button android:id="@+id/btnSignIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_label_28" android:textAllCaps="false" android:textColor="@android:color/white" android:backgroundTint="@color/green" />
        </FrameLayout>
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
          <Button android:id="@+id/btnSignUp" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_label_29" android:textAllCaps="false" android:textColor="@color/green" android:backgroundTint="@android:color/white" />
        </FrameLayout>
      </LinearLayout>
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSignInFacebook" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="16dp" android:text="@string/ui_label_30" android:textAllCaps="false" app:icon="@drawable/icon_facebook" app:iconGravity="textStart" />
      <com.google.android.material.button.MaterialButton android:id="@+id/btnSignInGoogle" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:text="@string/ui_label_31" android:textAllCaps="false" app:icon="@drawable/icon_google" app:iconGravity="textStart" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_label_32" android:textSize="12sp" android:textColor="@color/ink" android:gravity="center" android:layout_marginTop="12dp" />
      <Button android:id="@+id/openDeliveryLogin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/delivery_login_title" android:textColor="@color/green" android:backgroundTint="@android:color/white" />
      <ImageView android:layout_width="100dp" android:layout_height="96dp" android:src="@drawable/dish_2" android:contentDescription="@null" android:layout_marginTop="20dp" android:scaleType="fitStart" />
    </LinearLayout>
  </RelativeLayout>
</androidx.core.widget.NestedScrollView>

