<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <ImageView android:id="@+id/avatar" android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_camera" android:contentDescription="Ảnh đại diện" android:scaleType="centerCrop" android:layout_gravity="center_horizontal" />
    <Button android:id="@+id/takeAvatar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chụp ảnh đại diện" />
    <Button android:id="@+id/enableNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bật thông báo đơn hàng" />
    <EditText android:id="@+id/txtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_3" android:inputType="textPersonName" android:textSize="16sp" android:drawableStart="@drawable/ic_user" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
    <EditText android:id="@+id/txtEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_4" android:inputType="textEmailAddress" android:textSize="16sp" android:drawableStart="@drawable/icon_email" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
    <EditText android:id="@+id/txtPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_35" android:inputType="phone" android:textSize="16sp" android:drawableStart="@drawable/ic_phone" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
    <EditText android:id="@+id/txtAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:hint="@string/ui_label_21" android:inputType="textPostalAddress" android:textSize="16sp" android:drawableStart="@drawable/ic_address" android:drawablePadding="12dp" android:padding="12dp" android:importantForAutofill="no"  android:layout_marginBottom="10dp" />
    <Button android:id="@+id/btnUpdate" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_label_36" android:textAllCaps="false" android:textColor="@android:color/white" android:backgroundTint="@color/green" />
    <Button android:id="@+id/btnChangePassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/ui_label_37" android:textAllCaps="false" android:textColor="@color/green" android:backgroundTint="@android:color/white" />
  </LinearLayout>
</androidx.core.widget.NestedScrollView>
